NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Required in production: set the complete provider URL in the backend's
# deployment environment, not this file. Keep the provider's SSL parameters.
# Vercel/Neon: use the pooled URL with SSL enabled (sslmode=require/verify-full).
# Render: the Blueprint supplies the internal URL for the same-region database.
# Leave empty locally to use DB_* below. Production never loads this .env file.
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=grocery_pos
DB_USER=postgres
# Set your own local PostgreSQL password in the ignored backend/.env file.
DB_PASSWORD=
# Local DB_* connections only; DATABASE_URL controls its own SSL settings.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change_this_secret_before_production
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
